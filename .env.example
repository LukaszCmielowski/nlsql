# DCH gateway, without API path. TLS verification stays enabled.
DCH_HOST=dch.example.com:443
DCH_TOKEN=
DCH_TENANT_ID=my-tenant
DCH_CONNECTION_ID=
# Optional CA file for the gateway; leave empty for the default trust store.
DCH_CA_CERT=
DCH_FLIGHT_TIMEOUT=30

# One-time PostgreSQL registration with `dch-nlsql create-connection`.
# The command finds the type ID by this name (case-insensitive exact match).
DCH_CONNECTION_TYPE_NAME=Postgres
# Keep the URI quoted, especially if the password or URI contains special characters.
POSTGRES_URI=
# Optional CA file for PostgreSQL itself, distinct from the DCH gateway CA above.
POSTGRES_CA_CERT=

# Any OpenAI-compatible chat completions endpoint, including RHOAI/vLLM.
LLM_BASE_URL=https://model.example.com/v1
# A real API key is required for protected endpoints such as MaaS; otherwise leave empty.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
# Optional CA bundle for a model endpoint using a private CA.
SSL_CERT_FILE=

# Match the source's dialect: postgres, sqlite, or duckdb.
NLSQL_DIALECT=postgres
NLSQL_MAX_ROWS=100
